<!-- File: PresenceCard.xaml | Description: Discord-style "Playing..." card shown on the Dashboard (live) and Presets page (preview) | Author: Jose-Jorge HERNANDEZ | Company: Parlee Conseiller, Inc. | Date: 2026-10-09 | Last edit date: 2026-10-09 | Version: 1.0.0 -->
<UserControl x:Class="DiscordStatusUpdater.Controls.PresenceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource PreviewCard}">
        <StackPanel>
            <!-- Header strip: "PLAYING" + the activity name Discord would show -->
            <Border Background="#0D0E10" Padding="14,9">
                <TextBlock FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}">
                    <Run Text="{Binding Heading, ElementName=Root, Mode=OneWay}"/>
                </TextBlock>
            </Border>

            <StackPanel Margin="14,12,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- App tile: initials on a blurple gradient (real icons come from the Discord application's assets) -->
                    <Border Width="70" Height="70" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5865F2" Offset="0"/>
                                <GradientStop Color="#3C4270" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding Initials, ElementName=Root}"
                                   FontSize="24" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName, ElementName=Root}"
                                   FontWeight="Bold" FontSize="14" Foreground="White"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding Details, ElementName=Root}"
                                   FontSize="13" Foreground="{StaticResource TextNormal}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                        <TextBlock Text="{Binding State, ElementName=Root}"
                                   FontSize="13" Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,1"/>
                        <TextBlock Text="{Binding Elapsed, ElementName=Root}"
                                   FontSize="12" Foreground="{StaticResource Success}"/>
                    </StackPanel>
                </Grid>

                <Border Visibility="{Binding Button1, ElementName=Root, Converter={StaticResource StringToVis}}"
                        Background="{StaticResource BgHover}" BorderBrush="#3A3C42" BorderThickness="1"
                        CornerRadius="4" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock Text="{Binding Button1, ElementName=Root}" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"/>
                </Border>
                <Border Visibility="{Binding Button2, ElementName=Root, Converter={StaticResource StringToVis}}"
                        Background="{StaticResource BgHover}" BorderBrush="#3A3C42" BorderThickness="1"
                        CornerRadius="4" Padding="10,7" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Button2, ElementName=Root}" HorizontalAlignment="Center"
                               FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
